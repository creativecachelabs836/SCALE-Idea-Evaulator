# ---------------------------------------------------------------------------
# S.C.A.L.E. Strategic Evaluator — local configuration
# Copy to .env.local. Never commit real values.
#
# Iteration 0 needs none of this to run. Entries are added as the iterations
# that use them land, so this file stays an accurate description of what the
# application actually reads.
# ---------------------------------------------------------------------------

# Minimum words required in the idea description. The product promise is 75.
# (Iteration 3)
SCALE_MIN_DESCRIPTION_WORDS=75
SCALE_MAX_DESCRIPTION_WORDS=500
