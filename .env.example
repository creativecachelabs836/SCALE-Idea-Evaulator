# ---------------------------------------------------------------------------
# S.C.A.L.E. Strategic Evaluator - environment configuration
# Copy to .env.local. Never commit real values. No model credentials are ever
# exposed to the browser (NFR: "no client-side model keys").
# ---------------------------------------------------------------------------

# Which evaluation provider the orchestrator uses.
#   mock            - deterministic fixture provider, no network, no key (default)
#   openai-agent    - OpenAI Agent Builder workflow (spec section 8)
#   openai-responses- OpenAI Responses API w/ structured output + web search
SCALE_PROVIDER=mock

# Server-side only. Required for the openai-* providers.
OPENAI_API_KEY=

# The S.C.A.L.E. Agent Builder workflow (spec section 8).
SCALE_WORKFLOW_ID=wf_69db31a9f2dc8190986dec2bb55300650d19df1574b9f7ee

# Model used by the openai-responses provider.
SCALE_MODEL=gpt-5

# Where the SQLite database file lives.
SCALE_DB_PATH=./data/scale.db

# Minimum words required in the idea description (spec: the only required input).
SCALE_MIN_DESCRIPTION_WORDS=75
SCALE_MAX_DESCRIPTION_WORDS=500

# Chromium executable used for PDF rendering. Leave blank to auto-detect.
SCALE_CHROMIUM_PATH=

# Per-IP evaluation submissions allowed per hour.
SCALE_RATE_LIMIT_PER_HOUR=10
